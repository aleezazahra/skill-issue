# Server
PORT=4000
WEB_ORIGIN=http://localhost:5173

# AI provider: ollama | openrouter
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3n:e4b
OLLAMA_FALLBACK_MODEL=gemma3n:e2b
# Disable thinking traces for models that support them (gemma3n:e4b does).
OLLAMA_THINK=false

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# GitHub (optional, raises rate limit)
GITHUB_TOKEN=

# Analysis bounds
MAX_REPOSITORIES=6
MAX_ISSUE_RESULTS=24
AI_TIMEOUT_MS=240000
GITHUB_TIMEOUT_MS=15000
